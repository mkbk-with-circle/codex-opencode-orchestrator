#!/usr/bin/env bash
# 编排器便捷入口（把本仓 bin/ 加到 PATH 后，任意目录可用）。
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CMD="${1:-}"

case "$CMD" in
  ""|shell|cli)
    shift || true
    exec bash "$ROOT/scripts/codex-in-workspace.sh" "$@"
    ;;
  exec)
    shift
    exec bash "$ROOT/scripts/codex-in-workspace.sh" exec "$@"
    ;;
  resume)
    shift
    exec bash "$ROOT/scripts/sessions.sh" resume "$@"
    ;;
  sessions)
    shift
    exec bash "$ROOT/scripts/sessions.sh" list "$@"
    ;;
  session)
    shift
    sub="${1:-}"
    case "$sub" in
      pin) shift; exec bash "$ROOT/scripts/sessions.sh" pin "$@" ;;
      last|id) exec bash "$ROOT/scripts/sessions.sh" last ;;
      list|ls|"") exec bash "$ROOT/scripts/sessions.sh" list ;;
      *) exec bash "$ROOT/scripts/sessions.sh" "$@" ;;
    esac
    ;;
  poll)
    shift
    exec bash "$ROOT/scripts/poll.sh" "$@"
    ;;
  watch)
    shift
    exec bash "$ROOT/scripts/supervisor-v2.sh" "$@"
    ;;
  plan)
    shift
    sub="${1:-validate}"; shift || true
    case "$sub" in
      validate) exec bash "$ROOT/bin/orch" bridge plan-validate "$@" ;;
      approve) exec bash "$ROOT/bin/orch" bridge plan-approve "$@" ;;
      migrate) exec bash "$ROOT/bin/orch" bridge plan-migrate "$@" ;;
      *) echo "未知 plan 子命令: $sub（validate|approve|migrate）" >&2; exit 1 ;;
    esac
    ;;
  run)
    shift
    sub="${1:-status}"; shift || true
    case "$sub" in
      start) exec bash "$ROOT/bin/orch" bridge run-start "$@" ;;
      dispatch) exec bash "$ROOT/bin/orch" bridge run-dispatch "$@" ;;
      model) exec bash "$ROOT/bin/orch" bridge run-model "$@" ;;
      replace-session) exec bash "$ROOT/bin/orch" bridge run-replace-session "$@" ;;
      status) exec bash "$ROOT/bin/orch" bridge run-status "$@" ;;
      list) exec bash "$ROOT/bin/orch" bridge run-list "$@" ;;
      poll) exec bash "$ROOT/bin/orch" bridge run-poll "$@" ;;
      reply)
        if [[ -t 0 ]]; then
          printf '请输入凭据、验证码或回答（输入不会显示）：' >&2
          IFS= read -r -s human_reply
          printf '\n' >&2
          printf '%s' "$human_reply" | bash "$ROOT/bin/orch" bridge human-reply-v2 "$@" --stdin
          unset human_reply
          exit 0
        fi
        exec bash "$ROOT/bin/orch" bridge human-reply-v2 "$@" --stdin
        ;;
      complete) exec bash "$ROOT/bin/orch" bridge run-complete "$@" ;;
      pause) exec bash "$ROOT/bin/orch" bridge run-pause "$@" ;;
      resume) exec bash "$ROOT/bin/orch" bridge run-resume "$@" ;;
      cancel) exec bash "$ROOT/bin/orch" bridge run-cancel "$@" ;;
      *) echo "未知 run 子命令: $sub（start|dispatch|model|replace-session|status|list|poll|reply|complete|pause|resume|cancel）" >&2; exit 1 ;;
    esac
    ;;
  authority)
    shift
    sub="${1:-status}"; shift || true
    case "$sub" in
      status) exec bash "$ROOT/bin/orch" bridge authority-status "$@" ;;
      grant) exec bash "$ROOT/bin/orch" bridge authority-grant "$@" ;;
      allow) exec bash "$ROOT/bin/orch" bridge authority-grant --persistent "$@" ;;
      finish) exec bash "$ROOT/bin/orch" bridge authority-finish "$@" ;;
      return|enforce) exec bash "$ROOT/bin/orch" bridge authority-return "$@" ;;
      *) echo "未知 authority 子命令: $sub（status|grant|allow|finish|return）" >&2; exit 1 ;;
    esac
    ;;
  phase)
    shift
    sub="${1:-status}"; shift || true
    case "$sub" in
      start) exec bash "$ROOT/bin/orch" bridge phase-start "$@" ;;
      report) exec bash "$ROOT/bin/orch" bridge phase-report "$@" ;;
      review) exec bash "$ROOT/bin/orch" bridge phase-review "$@" ;;
      retry) exec bash "$ROOT/bin/orch" bridge phase-retry "$@" ;;
      acceptance) exec bash "$ROOT/bin/orch" bridge phase-acceptance "$@" ;;
      status) exec bash "$ROOT/bin/orch" bridge run-status "$@" ;;
      *) echo "未知 phase 子命令: $sub（start|report|review|retry|status）" >&2; exit 1 ;;
    esac
    ;;
  doctor)
    exec bash "$ROOT/scripts/doctor.sh"
    ;;
  install)
    shift
    exec bash "$ROOT/scripts/install.sh" "$@"
    ;;
  workspace|set-workspace)
    shift
    if [[ -n "${1:-}" ]]; then
      exec bash "$ROOT/scripts/set-workspace.sh" "$@"
    fi
    cd "$ROOT/packages/bridge"
    exec npx tsx src/cli.ts workspace
    ;;
  wait-reply|provide-reply|begin-hold)
    shift
    cd "$ROOT/packages/bridge"
    case "$CMD" in
      wait-reply) exec npx tsx src/cli.ts wait-reply "$@" ;;
      provide-reply) exec npx tsx src/cli.ts provide-reply "$@" ;;
      begin-hold) exec npx tsx src/cli.ts begin-hold "$@" ;;
    esac
    ;;
  use|profiles)
    shift
    cd "$ROOT/packages/bridge"
    if [[ "$CMD" == "profiles" ]]; then
      exec npx tsx src/cli.ts profiles
    fi
    exec npx tsx src/cli.ts use "$@"
    ;;
  model)
    shift
    sub="${1:-list}"; shift || true
    case "$sub" in
      add) exec bash "$ROOT/bin/orch" bridge model-add "$@" ;;
      check) exec bash "$ROOT/bin/orch" bridge model-check "$@" ;;
      list) exec bash "$ROOT/bin/orch" profiles ;;
      use) exec bash "$ROOT/bin/orch" use "$@" ;;
      *) echo "未知 model 子命令: $sub（add|check|list|use）" >&2; exit 1 ;;
    esac
    ;;
  bridge)
    shift
    cd "$ROOT/packages/bridge"
    exec npx tsx src/cli.ts "$@"
    ;;
  smoke)
    exec bash "$ROOT/scripts/smoke-dispatch.sh"
    ;;
  help|-h|--help)
    cat <<EOF
orch — Codex ↔ OpenCode Orchestrator

会话 / 业务仓
  orch                         在当前目录开新 Codex 会话（并绑定）
  orch workspace [路径]        查看或绑定业务仓
  orch sessions                列出本仓 Codex 会话
  orch resume [id|名|#]        恢复本仓会话（不是 OpenCode bridge resume）
  orch session pin <名>        给最近会话起别名
  orch session last            打印最近会话 uuid
  orch exec "…"                非交互跑一轮 codex exec

切换 API / 模型（名字来自 config/profiles.yaml）
  orch model add ...           注册 OpenCode provider/model/profile
  orch model check [profile]  检查模型和 API Key 环境变量
  orch model list|use         列出或切换 OpenCode 模型
  orch use                     列出可选 profile，并显示当前选中
  orch use ikuncode-haiku      IKunCode · Haiku（便宜，默认）
  orch use ikuncode-sonnet     IKunCode · Sonnet（更强；同商家尽量保留上下文）
  orch use siliconflow-v3      SiliconFlow · DeepSeek V3（需 .env 有对应 Key）
  orch use mock                不调真实 API（冒烟）
  orch profiles                同 orch use（仅列表）

轮询 / 等人输入
  orch watch start|stop|status  v2 事件 supervisor（推荐）
  orch poll start [--interval 60] [--session uuid]
  orch poll stop
  orch begin-hold [--kind otp] [--hint '…']
  orch wait-reply [--timeout 900]
  orch run reply --run <runId>   无回显投递凭据、验证码或回答

控制面
  orch plan validate|approve|migrate  v2 Plan 校验、冻结与 v1 迁移
  orch run start|dispatch|status|poll|reply|pause|resume|cancel|complete
  orch authority status|grant|allow|finish|return
  orch phase start|report|acceptance|review|retry
  orch bridge <子命令>         如 status / dispatch / resume / mark-complete
  orch doctor | install | smoke | help

文档:
  $ROOT/docs/USAGE.md
  $ROOT/docs/ORCH.md
  $ROOT/config/README.md
EOF
    ;;
  *)
    echo "未知子命令: $CMD（试 orch help）" >&2
    exit 1
    ;;
esac
