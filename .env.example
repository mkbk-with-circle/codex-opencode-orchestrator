# Copy to .env and fill in. Never commit .env.
# 这里只放「密钥 / 连接」，不放模型列表（模型在 opencode.json + config/profiles.yaml）。

# --- 商家 API Key（变量名须与 opencode.json 里 {env:XXX} 一致）---
IKUNCODE_API_KEY=sk-your-key-here
# SILICONFLOW_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# --- OpenCode 本地 HTTP 服务 ---
OPENCODE_BASE_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_PASSWORD=

# --- 可选编排开关（与模型无关）---
# ORCHESTRATOR_PROFILE=ikuncode-haiku
# ORCHESTRATOR_SAVE_BRIEFS=0
